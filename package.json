{
  "name": "cumplia",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de cumplimiento (GRC) para pymes y consultores de LATAM",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @cumplia/e2e test:e2e",
    "manual:capturas": "pnpm --filter @cumplia/e2e manual",
    "dev:api": "pnpm --filter @cumplia/api dev",
    "dev:web": "pnpm --filter @cumplia/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "^16.3.8",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
