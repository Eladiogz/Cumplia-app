{
  "name": "cumplia",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de cumplimiento (GRC) para pymes y consultores de LATAM",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
