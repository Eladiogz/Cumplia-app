// Modelo de datos multi-tenant (Fase 2: se conecta a la API).
// Toda tabla de negocio lleva organizationId y se filtra siempre por él.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CONSULTANT
  AUDITOR
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  createdAt   DateTime     @default(now())
  members     Membership[]
  assessments Assessment[]
  auditLogs   AuditLog[]
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  memberships Membership[]
}

model Membership {
  id             String       @id @default(uuid())
  role           Role
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

model Assessment {
  id             String        @id @default(uuid())
  organizationId String
  frameworkId    String
  targetMaturity Int           @default(3)
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  answers        ControlAnswer[]

  @@index([organizationId])
}

model ControlAnswer {
  id            String     @id @default(uuid())
  assessmentId  String
  controlId     String
  applicable    Boolean    @default(true)
  maturity      Int?
  justification String?
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  evidence      Evidence[]

  @@unique([assessmentId, controlId])
}

model Evidence {
  id              String        @id @default(uuid())
  controlAnswerId String
  source          String        // manual, m365, github...
  description     String
  collectedAt     DateTime      @default(now())
  controlAnswer   ControlAnswer @relation(fields: [controlAnswerId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String?
  action         String
  entity         String
  entityId       String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}
