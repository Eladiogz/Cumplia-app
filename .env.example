# La API se conecta con un usuario SIN privilegios (miembro del rol cumplia_app):
# así Row-Level Security aísla las organizaciones también dentro de la base.
DATABASE_URL=postgresql://cumplia_api:cumplia_api@localhost:5432/cumplia
# Las migraciones corren con el dueño de las tablas.
MIGRATION_DATABASE_URL=postgresql://cumplia:cumplia@localhost:5432/cumplia
PORT=3000
# La web (puerto 3001) reenvía /api/* a la API. La API confía en X-Forwarded-For solo
# si viene de estas IPs (el proxy) y sabe que el navegador la ve bajo /api.
TRUST_PROXY=127.0.0.1,::1
API_PUBLIC_PREFIX=/api
# Para la web: a dónde reenvía /api/* (se lee al compilar y al arrancar la web)
API_URL=http://localhost:3000
# Origen(es) del frontend autorizados (separados por coma)
APP_ORIGIN=http://localhost:3001
# URL del frontend para los links de los emails (por defecto, el primer APP_ORIGIN)
# APP_URL=http://localhost:3001
# Emails. En desarrollo, Mailpit (docker compose up -d mail): bandeja en http://localhost:8025
# En producción es obligatorio, p. ej. smtps://usuario:clave@smtp.proveedor.com:465
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Cumplia <no-reply@cumplia.local>"
# Solo desarrollo: permite indicar la organización con el header x-organization-id
ALLOW_DEV_TENANT_HEADER=false
# Clave AES-256 que cifra los secretos MFA (32 bytes en base64). Obligatoria.
# Generala con: openssl rand -base64 32  — usá una distinta por entorno y no la pierdas:
# sin ella, quienes tengan MFA activo no podrán iniciar sesión.
MFA_ENCRYPTION_KEY=
